{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harrier.dev/schemas/findings.schema.json",
  "title": "Harrier findings report",
  "type": "object",
  "required": [
    "schemaVersion",
    "tool",
    "target",
    "startedAt",
    "finishedAt",
    "summary",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "tool": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        }
      }
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "overview": {
      "type": "string"
    },
    "probes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/probeRun"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "bySeverity",
        "byCategory",
        "bySource"
      ],
      "additionalProperties": false,
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "bySeverity": {
          "$ref": "#/$defs/countMap"
        },
        "byCategory": {
          "$ref": "#/$defs/countMap"
        },
        "bySource": {
          "$ref": "#/$defs/countMap"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "gate": {
      "type": "object",
      "required": [
        "status",
        "exitCode"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "incomplete"
          ]
        },
        "exitCode": {
          "enum": [
            0,
            1,
            2
          ]
        }
      }
    },
    "aiCoverage": {
      "type": "object",
      "required": [
        "status",
        "mode",
        "plannedFiles",
        "plannedRanges",
        "batches",
        "skipped"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "failed",
            "disabled"
          ]
        },
        "mode": {
          "enum": [
            "diff",
            "repository"
          ]
        },
        "plannedFiles": {
          "type": "integer",
          "minimum": 0
        },
        "plannedRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "startLine",
              "endLine"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "startLine": {
                "type": "integer",
                "minimum": 1
              },
              "endLine": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "index",
              "ranges",
              "supportRanges",
              "passes",
              "verifier"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 1
              },
              "ranges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "startLine",
                    "endLine"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "supportRanges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "startLine",
                    "endLine"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              },
              "passes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "pass",
                    "status"
                  ]
                }
              },
              "verifier": {
                "enum": [
                  "ok",
                  "failed",
                  "not-needed"
                ]
              }
            }
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "reason"
            ]
          }
        },
        "detail": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "probeRun": {
      "type": "object",
      "required": [
        "probe",
        "categories",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "probe": {
          "type": "string",
          "minLength": 1
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "ok",
            "skipped",
            "failed"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "location": {
      "type": "object",
      "required": [
        "path",
        "startLine"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "startColumn": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "endColumn": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "ruleId",
        "ruleName",
        "category",
        "severity",
        "message",
        "locations",
        "source",
        "fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ruleId": {
          "type": "string",
          "minLength": 1
        },
        "ruleName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "dependency",
            "secret",
            "security",
            "quality",
            "structure",
            "bug"
          ]
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "source": {
          "enum": [
            "probe",
            "llm"
          ]
        },
        "probe": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "evidence": {
          "type": "string"
        },
        "fixHint": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
